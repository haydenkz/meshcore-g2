{
  "name": "meshcore-g2",
  "private": true,
  "version": "0.1.0",
  "description": "A demo MeshCore HUD for Even Realities G2 glasses",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "simulate": "evenhub-simulator http://localhost:5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test src/hud.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o meshcore-hud.ehpk --sdk-ver 0.0.15",
    "qr": "evenhub qr"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  }
}
